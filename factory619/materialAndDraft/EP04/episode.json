  "dialogue": [
    {
      "id": "l1",
      "speaker": "nguoi_boc_tran",
      "start": 0.05,
      "window": 7.05,
      "text": "Đêm khuya kẻ gian rảo khắp phố, lén dán đè mã thanh toán của chúng lên hàng chục quán ăn!"
    },
    {
      "id": "l2",
      "speaker": "co_tu",
      "start": 7.12,
      "window": 6.3,
      "text": "Khoan đã anh ơi! Sáng giờ mấy chục khách báo chuyển rồi mà máy tôi chưa nhận được đồng nào!"
    },
    {
      "id": "l3",
      "speaker": "anh_hai",
      "start": 13.45,
      "window": 5.6,
      "text": "Cô nói kỳ vậy?! Tôi quét đúng bảng mã trên quầy cô, trừ tiền thành công rõ ràng đây nè!"
    },
    {
      "id": "l4",
      "speaker": "thang_tun",
      "start": 19.05,
      "window": 5.35,
      "text": "Hai người đừng cãi nhau! Em vừa quét thử nè, sao quán Cô Tư mà tên người nhận lạ hoắc?!"
    },
    {
      "id": "l5",
      "speaker": "thang_tun",
      "start": 24.42,
      "window": 4.6,
      "text": "Nhìn sát vô bảng mã kìa! Có nguyên một miếng decal mới tinh vừa bị ai dán đè lên trên!"
    },
