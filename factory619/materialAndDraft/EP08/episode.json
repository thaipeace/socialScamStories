  "dialogue": [
    {
      "id": "l1",
      "speaker": "ke_ngot_ngao_nu",
      "start": 0.38,
      "window": 5.77,
      "text": "Bài đạt rồi nha! Chị mới chuyển ba triệu rưỡi, biên lai đó em.",
      "style": "Giọng nữ miền Nam Sài Gòn 30 tuổi, giữ cố định một âm sắc tự nhiên, lịch sự chuyên nghiệp như người thuê việc vừa duyệt bài xong, nhịp nói gọn gàng, rõ chữ.",
      "af": "phone"
    },
    {
      "id": "l2",
      "speaker": "thang_tun",
      "start": 4.89,
      "window": 4.6,
      "text": "Ủa sao máy em chưa báo tiền vô chị?",
      "style": "Giọng nam thanh niên miền Nam Sài Gòn 20 tuổi, giữ cố định một âm sắc trẻ trung tự nhiên, hơi mệt sau ca làm khuya, thắc mắc ngắn gọn, rõ chữ."
    },
    {
      "id": "l3",
      "speaker": "ke_ngot_ngao_nu",
      "start": 8.66,
      "window": 6.4,
      "text": "Cuối năm nghẽn liên ngân hàng. Bấm link xác nhận nhận tiền đi, quá giờ nó hoàn lệnh đó.",
      "style": "Giọng nữ miền Nam Sài Gòn 30 tuổi, giữ cố định âm sắc, điềm nhiên chuyên nghiệp khi hướng dẫn nhưng giục khéo tạo áp lực thời gian, nhịp nhanh gọn, rõ chữ.",
      "af": "phone"
    },
    {
      "id": "l4",
      "speaker": "ke_ngot_ngao_nu",
      "start": 14.52,
      "window": 5.2,
      "text": "Mã giải ngân về máy rồi kìa, nhập lẹ đi em, sắp hết giờ!",
      "style": "Giọng nữ miền Nam Sài Gòn 30 tuổi, giữ cố định âm sắc, chuyển sang gấp gáp thúc giục dồn dập vì sắp hết giờ giải ngân, nhịp nhanh, sắc, rõ chữ.",
      "af": "phone"
    },
    {
      "id": "l5",
      "speaker": "thang_tun",
      "start": 17.88,
      "window": 3.6,
      "text": "Dạ có mã rồi, em bấm liền!",
      "style": "Giọng nam thanh niên miền Nam Sài Gòn 20 tuổi, giữ cố định âm sắc, luống cuống vội vàng bấm xác nhận cho kịp giờ, nhịp nhanh gọn, rõ chữ."
    },
    {
      "id": "l6",
      "speaker": "thang_tun",
      "start": 26.43,
      "window": 7.06,
      "text": "Ủa, sao lại trừ sạch tiền của em?! Alo, chặn số mất rồi!",
      "style": "Giọng nam thanh niên miền Nam Sài Gòn 20 tuổi, giữ cố định âm sắc nhưng bàng hoàng sững sờ, thảng thốt nghẹn giọng khi thấy tài khoản bị trừ sạch tiền và gọi lại bị chặn số, rõ chữ."
    },
    {
      "id": "l7",
      "speaker": "nguoi_boc_tran",
      "start": 33.14,
      "window": 5.76,
      "text": "Biên lai báo nghẽn chỉ là mồi nhử để dẫn bạn vào trang giả.",
      "style": "Giọng nam trung niên miền Nam Sài Gòn, trầm tĩnh, khách quan, sắc lạnh vạch trần bản chất cơ chế, nhịp gọn dứt khoát, rõ chữ, tuyệt đối không kéo dài giọng hay rao giảng dạy đời."
    },
    {
      "id": "l8",
