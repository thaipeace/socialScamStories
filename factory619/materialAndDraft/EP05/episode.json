  "dialogue": [
    {
      "id": "l1",
      "speaker": "ke_ngot_ngao_nam",
      "start": 0.2,
      "window": 5.1,
      "text": "Anh thương em mới chỉ mối chốt đơn sàn thương mại, mình kiếm tiền lo đám cưới nha em yêu!"
    },
    {
      "id": "l2",
      "speaker": "be_na",
      "start": 5.6,
      "window": 5.4,
      "text": "Mấy đơn đầu rút lãi dễ ợt, sao em vừa nạp ba mươi triệu lại bị khóa tài khoản anh?!"
    },
    {
      "id": "l3",
      "speaker": "ke_ngot_ngao_nam",
      "start": 11.2,
      "window": 4.7,
      "text": "Em bấm sai cú pháp rồi! Nạp gấp năm mươi triệu gỡ lệnh đi, không là mất sạch tiền đó!"
    },
    {
      "id": "l4",
      "speaker": "be_na",
      "start": 16.1,
      "window": 6.4,
      "text": "Chị Ba ơi cho em mượn tiền gỡ đơn với! Không nạp là mất sạch, ảnh cũng bỏ em luôn!"
    },
    {
      "id": "l5",
      "speaker": "chi_ba",
      "start": 22.6,
      "window": 5.8,
      "text": "Đưa máy đây! Em gái tôi gom đủ năm mươi triệu rồi, anh bật camera vẫy tay tôi chuyển liền!"
    },
    {
      "id": "l6",
      "speaker": "ke_ngot_ngao_nam",
      "start": 28.6,
      "window": 5.6,
      "text": "Thấy anh chưa, chuyển lẹ... Ủa?! Tắt máy, tắt máy lẹ!"
    },
    {
      "id": "l7",
      "speaker": "be_na",
      "start": 35.2,
      "window": 6.5,
      "text": "Trời đất ơi... Lộ mặt thật ngồi giữa ổ lừa đảo, vậy mà em tưởng chồng sắp cưới!"
    },
    {
      "id": "l8",
      "speaker": "nguoi_boc_tran",
      "start": 42.0,
      "window": 7.45,
      "text": "Chúng dùng lời yêu thương làm mồi nhử, thả chút hoa hồng đầu rồi khóa tài khoản vét cạn tiền!"
    },
    {
      "id": "l9",
      "speaker": "chi_ba",
      "start": 49.65,
      "window": 6.25,
      "text": "Ngừng chuyển tiền ngay lập tức! Lưu hết tin nhắn lại đi trình báo, tuyệt đối đừng nạp thêm nữa!"
    }
  ],
