  "dialogue": [
    {
      "id": "l1",
      "speaker": "chi_ba",
      "start": 0.32,
      "window": 6.06,
      "text": "Hình check-in cả nhà đi biển bốn ngày hôm bữa, quá trời người thả tim nè anh!"
    },
    {
      "id": "l1b",
      "speaker": "anh_hai",
      "start": 5.18,
      "window": 5.1,
      "text": "Xe tới cổng nhà mình rồi kìa, xuống mở khóa vô nhà thôi em!"
    },
    {
      "id": "l2",
      "speaker": "ke_ngot_ngao_nam",
      "start": 9.44,
      "window": 5.18,
      "text": "Nhà này đăng hình đi biển bốn ngày chưa về, vô cạy khóa lẹ!",
      "af": "default",
      "style": "Giọng nam miền Nam Sài Gòn 28 tuổi, hạ giọng ranh mãnh, thì thầm gấp gáp với đồng bọn trong đêm, nhịp nói nhanh gọn, rõ chữ, tuyệt đối không kéo dài."
    },
    {
      "id": "l3",
      "speaker": "anh_hai",
      "start": 13.5,
      "window": 6.06,
      "text": "Ủa mình ơi, đi chơi về sao ổ khóa bị cạy xước hết?!"
    },
    {
      "id": "l4",
      "speaker": "chi_ba",
      "start": 18.74,
      "window": 5.42,
      "text": "Trời ơi, nhà suýt mất trộm mà đi chơi không biết gì!"
    },
    {
      "id": "l5",
      "speaker": "ong_bay",
      "start": 22.96,
      "window": 4.82,
      "text": "May mà tổ an ninh khu phố có kết bạn mạng với tụi con!",
      "style": "Giọng nam miền Nam Sài Gòn 58 tuổi, chú tổ trưởng an ninh khu phố lanh lẹ, nhịp nói nhanh gọn, dứt khoát, sắc bén, rõ chữ, tuyệt đối không kéo dài chữ hay ngân giọng chậm."
    },
    {
      "id": "l6",
      "speaker": "chu_bao_ve",
      "start": 26.98,
      "window": 6.3,
      "text": "Thấy gia đình đăng bài đi vắng sơ hở, đêm qua mấy chú tuần tra canh giùm!",
      "voice": "Fenrir",
      "af": "default",
      "style": "Giọng nam miền Nam Sài Gòn 50 tuổi, chú tuần tra an ninh khu phố nhanh nhẹn, dứt khoát, nhịp nói nhanh gọn, rõ chữ, tự nhiên, tuyệt đối không nghỉ dài giữa câu hay kéo giọng."
    },
    {
      "id": "l7",
      "speaker": "chi_ba",
      "start": 32.08,
      "window": 5.1,
      "text": "Hú hồn! Không có các chú tuần tra giúp là mất sạch rồi!"
    },
    {
      "id": "l8",
      "speaker": "nguoi_boc_tran",
      "start": 36.4,
      "window": 6.5,
      "text": "Đi chơi thường về nhà mới biết mất trộm; về nhà hãy đăng ảnh!",
      "subtitle": [
        "Đi chơi xa thường về nhà mới biết mất trộm;",
        "hãy đợi về đến nhà rồi mới đăng ảnh!"
