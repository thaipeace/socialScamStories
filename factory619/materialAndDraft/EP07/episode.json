  "dialogue": [
    {
      "id": "l1",
      "speaker": "ke_gia_danh",
      "start": 0.4,
      "window": 6.01,
      "text": "Cô Tư ơi, chuyển liền tiền quỹ ngày hội vô số em gửi nha, sắp khóa sổ rồi!"
    },
    {
      "id": "l2",
      "speaker": "co_tu",
      "start": 5.51,
      "window": 5.8,
      "text": "Ờ để cô chuyển liền năm trăm ngàn ủng hộ xóm mình!"
    },
    {
      "id": "l3",
      "speaker": "be_na",
      "start": 10.03,
      "window": 5.72,
      "text": "Con cũng đang đóng tiền cọc với bảo hiểm tình nguyện viên đêm văn hóa!"
    },
    {
      "id": "l4",
      "speaker": "ong_bay",
      "start": 14.9,
      "window": 6.8,
      "text": "Khoan bấm! Khu phố thu quỹ công khai, tình nguyện viên cũng không ai thu cọc!",
      "style": "Giọng nam miền Nam Sài Gòn 55 tuổi, chú tổ trưởng khu phố lanh lẹ, nhịp nói nhanh gọn, dứt khoát, sắc bén, rõ chữ, tuyệt đối không kéo dài hay ngân giọng."
    },
    {
      "id": "l5",
      "speaker": "be_na",
      "start": 20.42,
      "window": 6.44,
      "text": "Ủa chú Bảy, vậy trang sự kiện với người đang gọi cô Tư là ai?!"
    },
    {
      "id": "l6",
      "speaker": "ong_bay",
      "start": 26.06,
      "window": 5.92,
      "text": "Nhìn kỹ tên người nhận trên hai máy kìa! Toàn tài khoản cá nhân lạ hoắc!",
      "style": "Giọng nam miền Nam Sài Gòn 55 tuổi, chú tổ trưởng khu phố lanh lẹ, nhịp nói nhanh gọn, dứt khoát, sắc bén, rõ chữ, tuyệt đối không kéo dài hay ngân giọng."
    },
    {
      "id": "l7",
      "speaker": "be_na",
      "start": 30.7,
      "window": 6.08,
      "text": "Trời ơi thiệt luôn! Trang mới lập hôm qua mà bắt chuyển cho cá nhân!"
    },
    {
      "id": "l8",
      "speaker": "co_tu",
      "start": 35.5,
      "window": 6.32,
      "text": "Máy cô cũng tên cá nhân, nghe chú Bảy khui ra là nó cúp máy liền!"
    },
    {
      "id": "l9",
      "speaker": "nguoi_boc_tran",
      "start": 41.07,
      "window": 6.24,
      "text": "Mùa lễ hội, đừng chuyển tiền quỹ hay phí sự kiện vô tài khoản cá nhân!"
    }
  ],
