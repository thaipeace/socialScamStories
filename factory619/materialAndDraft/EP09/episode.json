  "dialogue": [
    {
      "id": "l1",
      "speaker": "be_na",
      "start": 0.85,
      "window": 4.05,
      "text": "Đang đợi gọi phỏng vấn mà nhỡ máy! Bấm gọi lại liền kẻo mất việc!",
      "style": "Giọng cô gái trẻ miền Nam Sài Gòn 22 tuổi, phát âm chuẩn phương ngữ miền Nam, giữ cố định một âm sắc tự nhiên đời thực, hơi gấp vì sợ trễ cuộc gọi phỏng vấn, nhịp nói nhanh gọn rõ chữ, tuyệt đối không rên rỉ cải lương."
    },
    {
      "id": "l2",
      "speaker": "be_na",
      "start": 5.25,
      "window": 5.0,
      "text": "Alo? Sao đồng hồ nhảy giây rồi mà bên kia đổ chuông hoài không ai nói?",
      "style": "Giọng cô gái trẻ miền Nam Sài Gòn 22 tuổi, phát âm chuẩn phương ngữ miền Nam, giữ cố định một âm sắc tự nhiên đời thực, sốt ruột thắc mắc khi đang áp máy lên tai chờ, nhịp gọn rõ chữ."
    },
    {
      "id": "l3",
      "speaker": "be_na",
      "start": 12.15,
      "window": 4.15,
      "text": "Ủa?! Chưa ai nói câu nào mà máy hết sạch tiền luôn?!",
      "style": "Giọng cô gái trẻ miền Nam Sài Gòn 22 tuổi, phát âm chuẩn phương ngữ miền Nam, giữ cố định một âm sắc tự nhiên đời thực, sững sờ bật thốt dứt khoát khi thấy điện thoại bị trừ hết sạch tiền, rõ chữ, không khóc lóc cải lương."
    },
    {
      "id": "l4",
      "speaker": "anh_hai",
      "start": 16.65,
      "window": 5.35,
      "text": "Em bị nó câu tiền rồi đó! Số nước ngoài thôi, ngân hàng không sao đâu.",
      "style": "Giọng nam miền Nam Sài Gòn 35 tuổi, phát âm chuẩn phương ngữ miền Nam, giữ cố định một âm sắc tự nhiên đời thường như anh trai nói chuyện với em gái ở nhà, bình tĩnh gọn nhẹ, nhịp nói nhanh vừa rõ chữ, tuyệt đối không lên giọng dạy đời hay đọc như bài giảng."
    },
    {
      "id": "l5",
      "speaker": "be_na",
      "start": 22.35,
      "window": 3.05,
      "text": "Nhưng lỡ mình đang đợi điện thoại thì sao anh?",
      "style": "Giọng cô gái trẻ miền Nam Sài Gòn 22 tuổi, phát âm chuẩn phương ngữ miền Nam, giữ cố định một âm sắc tự nhiên đời thường, hỏi ngắn gọn thẳng thắn như hai anh em nói chuyện ở nhà, nhịp gọn rõ chữ."
    },
    {
      "id": "l6",
      "speaker": "anh_hai",
      "start": 25.42,
      "window": 5.95,
      "text": "Thì coi trước, số trong nước mới gọi lại. Mà hỏi gọn thôi, đừng dài dòng, đề phòng lừa đảo.",
      "style": "Giọng nam miền Nam Sài Gòn 35 tuổi, phát âm chuẩn phương ngữ miền Nam, giữ cố định một âm sắc tự nhiên đời thường như anh trai nhắc nhẹ em gái lúc trò chuyện, nhịp nói trôi chảy nhanh gọn rõ chữ, tuyệt đối không ngừng dài kiểu đọc văn mẫu."
    },
    {
      "id": "l7",
      "speaker": "nguoi_boc_tran",
