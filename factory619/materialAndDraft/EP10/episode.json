  "dialogue": [
    {
      "id": "l1",
      "speaker": "thang_tun",
      "start": 0.55,
      "window": 5.05,
      "text": "Chị Hai, có hai cái Wi-Fi khách sạn luôn nè! Em bắt cái không mật khẩu cho lẹ nha!",
      "style": "Giọng nam thanh niên miền Nam Sài Gòn 20 tuổi, phát âm chuẩn phương ngữ miền Nam, giữ cố định một âm sắc sáng, nhanh nhảu tự nhiên như đang nói chuyện trực tiếp với chị ruột ở sảnh, nhịp gọn rõ chữ."
    },
    {
      "id": "l2",
      "speaker": "thang_tun",
      "start": 9.55,
      "window": 4.85,
      "text": "Ủa chị Hai, coi giùm em cái máy sao tự nhảy màn hình mà bấm không ăn nè?",
      "style": "Giọng nam thanh niên miền Nam Sài Gòn 20 tuổi, phát âm chuẩn phương ngữ miền Nam, giữ cố định một âm sắc tự nhiên đời thực, ngơ ngác hơi sốt ruột hỏi chị ngồi cạnh khi thấy điện thoại bị đơ nhảy loạn, không làm lố."
    },
    {
      "id": "l3",
      "speaker": "chi_hai",
      "start": 14.55,
      "window": 5.1,
      "text": "Đưa chị coi… Kỳ vậy, sao màn hình tự chạy mà bấm thoát không ăn?",
      "style": "Giọng phụ nữ miền Nam Sài Gòn 34 tuổi, phát âm cực chuẩn dấu thanh tiếng Việt (nhấn chuẩn chữ Đưa, chữ tự, không luyến dấu hỏi), giữ cố định một âm sắc ấm, trầm vừa, tự nhiên như người thường hơi nhíu mày khi cầm máy bấm thử lại."
    },
    {
      "id": "l4",
