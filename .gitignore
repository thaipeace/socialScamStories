# Rendered videos (giữ trên ổ đĩa / cloud, không đưa vào Git)
*.mp4
06_RENDERED_SHORTS/*
!06_RENDERED_SHORTS/.gitkeep
06_RENDERED_VIDEOS/*
!06_RENDERED_VIDEOS/.gitkeep

# WAV trung gian tái tạo được bằng engine (giữ MP3 và WAV giọng TTS gốc)
factory619/materialAndDraft/*/audio/mix/*.wav
factory619/materialAndDraft/*/audio/sfx/*.wav
factory619/materialAndDraft/*/audio/bgm/*.wav
factory196/materialAndDraft/*/audio/mix/*.wav
factory196/materialAndDraft/*/audio/sfx/*.wav
factory196/materialAndDraft/*/audio/bgm/*.wav

# Tập chạy thử engine
factory619/*/EP00_SMOKE/
factory196/*/EP00_SMOKE/

# Backup / tạm
factory619/materialAndDraft/*/assets/originals_backup/
factory619/materialAndDraft/*/_archive_*/
factory196/materialAndDraft/*/assets/originals_backup/
factory196/materialAndDraft/*/_archive_*/
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db

# Không bao giờ commit khóa API
*api-keys*.json
.env
